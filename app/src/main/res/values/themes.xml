<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Theme chính của KhoNova (Material Design 3 – Light) ===== -->
    <style name="Base.Theme.KhoNova" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/indigo_soft</item>
        <item name="colorOnPrimaryContainer">@color/navy</item>
        <item name="colorSecondary">@color/navy</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/indigo_soft</item>
        <item name="colorOnSecondaryContainer">@color/indigo</item>
        <item name="colorTertiary">@color/mint</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorError">@color/coral</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/tile_background</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorOutlineVariant">@color/border</item>
        <item name="colorControlHighlight">@color/indigo_alpha_12</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@style/KhoNova.WindowAnimation</item>

        <!-- Style mặc định cho các component -->
        <item name="materialCardViewStyle">@style/KhoNova.Card</item>
        <item name="textInputStyle">@style/KhoNova.TextInput</item>
        <item name="materialButtonStyle">@style/KhoNova.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.KhoNova.Dialog</item>
    </style>

    <style name="Theme.QuanLyKhoHang" parent="Base.Theme.KhoNova" />

    <!-- ===== Hiệu ứng chuyển Activity mượt (trượt nhẹ + mờ dần) ===== -->
    <style name="KhoNova.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>

    <!-- ===== Card ===== -->
    <style name="KhoNova.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/indigo_alpha_12</item>
    </style>

    <!-- ===== Ô nhập liệu ===== -->
    <style name="KhoNova.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeErrorColor">@color/coral</item>
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="hintEnabled">false</item>
        <item name="startIconTint">@color/selector_input_icon</item>
        <item name="endIconTint">@color/selector_input_icon</item>
        <item name="errorTextColor">@color/coral</item>
        <item name="errorIconDrawable">@null</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="suffixTextColor">@color/text_secondary</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.KhoNova.TextInput</item>
    </style>

    <style name="ThemeOverlay.KhoNova.TextInput" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">
        <item name="editTextStyle">@style/KhoNova.EditText</item>
    </style>

    <style name="KhoNova.EditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- ===== Nút bấm ===== -->
    <style name="KhoNova.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/selector_button_primary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/white_alpha_20</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="KhoNova.Button.Danger">
        <item name="backgroundTint">@color/coral</item>
    </style>

    <style name="KhoNova.Button.Tonal">
        <item name="backgroundTint">@color/indigo_soft</item>
        <item name="android:textColor">@color/indigo</item>
        <item name="iconTint">@color/indigo</item>
        <item name="rippleColor">@color/indigo_alpha_12</item>
    </style>

    <style name="KhoNova.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/navy</item>
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconTint">@color/navy</item>
        <item name="rippleColor">@color/indigo_alpha_12</item>
    </style>

    <!-- ===== Hộp thoại ===== -->
    <style name="ThemeOverlay.KhoNova.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/indigo</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/KhoNova.Shape.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/KhoNova.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/KhoNova.Dialog.Body</item>
        <item name="buttonBarNegativeButtonStyle">@style/KhoNova.Dialog.Button</item>
        <item name="buttonBarPositiveButtonStyle">@style/KhoNova.Dialog.Button</item>
    </style>

    <style name="KhoNova.Shape.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="KhoNova.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KhoNova.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="KhoNova.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ===== Kiểu chữ ===== -->
    <style name="KhoNova.Text" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="KhoNova.Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="KhoNova.Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KhoNova.Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="KhoNova.Text.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="KhoNova.Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="KhoNova.Text.Badge">
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="KhoNova.Text.SectionTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Nút icon trên header (nền kính mờ) ===== -->
    <style name="KhoNova.HeaderIconButton" parent="">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">@drawable/bg_glass_circle</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/white</item>
    </style>
</resources>
